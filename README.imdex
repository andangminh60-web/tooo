<!doctype html>
<html lang="vi"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><meta name="theme-color" content="#080d1c"><title>MINH AN MOD • Quản trị SERVER KEY</title>
<style>
:root{color-scheme:dark;--bg:#080d1c;--panel:#101a2d;--line:#294260;--text:#edf4ff;--muted:#a7b7cf;--blue:#2584ff;--cyan:#00b9ee}*{box-sizing:border-box}body{margin:0;padding:calc(20px + env(safe-area-inset-top)) 14px calc(30px + env(safe-area-inset-bottom));background:radial-gradient(ellipse at top,#172744,var(--bg) 65%);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text)}header{text-align:center;margin:8px auto 24px;max-width:760px}.brand{font:700 12px ui-monospace,monospace;letter-spacing:4px;color:#8db5ff}h1{font-size:clamp(25px,7vw,36px);margin:13px 0}h1 span{color:#8db5ff}.sub{color:var(--muted);line-height:1.6}.panel{max-width:760px;margin:0 auto 15px;padding:19px;border:1px solid #1a4a5d;border-radius:18px;background:linear-gradient(145deg,#101b30f5,#09111ffe);box-shadow:0 10px 30px #0003}h2{font-size:14px;letter-spacing:1.6px;color:#8db5ff;margin:2px 0 16px}label{display:block;color:#c7d7ed;font-size:13px;margin:11px 0 7px}input,select{width:100%;padding:13px;border:1px solid var(--line);border-radius:10px;background:#091321;color:var(--text);font-size:15px}button{border:0;border-radius:10px;background:linear-gradient(100deg,var(--blue),var(--cyan));color:white;font-weight:800;padding:13px 15px;font-size:14px;cursor:pointer;margin-top:10px;width:100%}button.secondary{background:#182b46;border:1px solid #365275}button.danger{background:#7e2636;border:1px solid #b34b60}button:disabled{opacity:.55}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.status,.result,.list{padding:12px;border:1px solid var(--line);border-radius:10px;background:#091321;color:#c5d6ed;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.5;margin-top:12px}.listitem{padding:12px 0;border-bottom:1px solid #263b56}.listitem:last-child{border-bottom:0}.tag{font-size:11px;border:1px solid #3c5879;border-radius:20px;padding:3px 8px;display:inline-block;margin:5px 0}.small{font-size:12px;line-height:1.6;color:var(--muted)}.hidden{display:none}.key{font:12px ui-monospace,monospace;overflow-wrap:anywhere;color:#9dc4ff}.toprow{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}.toprow button{width:auto;margin:0}.footer{text-align:center;color:#8297b2;font-size:12px;max-width:760px;margin:22px auto}
</style></head><body>
<header><div class="brand">MINH AN MOD</div><h1>QUẢN TRỊ <span>SERVER KEY</span></h1><div class="sub">Tạo key có hạn sử dụng, xem trạng thái và thu hồi key trên mọi thiết bị qua API chung.</div></header>
<section class="panel"><h2>01 • KẾT NỐI API</h2><label for="api">URL gốc của API (HTTPS)</label><input id="api" type="url" placeholder="https://api-tenmiencuaban.com" autocomplete="url"><label for="token">ADMIN_TOKEN</label><input id="token" type="password" placeholder="Dán token quản trị bí mật" autocomplete="off"><div class="grid"><button id="connect">KẾT NỐI & TẢI DANH SÁCH</button><button class="secondary" id="forget">XÓA THÔNG TIN</button></div><div class="status" id="status" role="status">Chưa kết nối. Token chỉ giữ trong bộ nhớ trang hiện tại, không được lưu vào HTML.</div><p class="small">Không dán ADMIN_TOKEN vào trang HTML công khai hoặc chia sẻ file này cho khách hàng. Chỉ sử dụng trên thiết bị quản trị của bạn.</p></section>
<section class="panel"><h2>02 • TẠO KEY MỚI</h2><label for="label">Tên khách hàng / ghi chú (không bắt buộc)</label><input id="label" maxlength="100" placeholder="Ví dụ: Khách hàng 01"><label for="days">Thời hạn</label><select id="days"><option value="1">1 ngày</option><option value="7">7 ngày</option><option value="30" selected>30 ngày</option><option value="90">90 ngày</option><option value="180">180 ngày</option><option value="365">365 ngày</option><option value="3650">3650 ngày</option></select><button id="create">TẠO KEY</button><div id="newkey" class="result hidden"></div><button id="copy" class="secondary hidden">SAO CHÉP KEY</button><p class="small">Key gốc chỉ được máy chủ trả về một lần. Hãy sao chép và gửi cho người dùng ngay sau khi tạo.</p></section>
<section class="panel"><div class="toprow"><h2 style="margin-bottom:0">03 • DANH SÁCH KEY</h2><button id="reload" class="secondary">LÀM MỚI</button></div><div id="keys" class="list">Kết nối API để tải danh sách key.</div></section>
<div class="footer">MINH AN MOD • Server là nguồn dữ liệu chính. Thu hồi có hiệu lực khi thiết bị kiểm tra API lần tiếp theo.</div>
<script>
(()=>{'use strict';const $=id=>document.getElementById(id);let currentKey='';let apiBase='';let adminToken='';
function setStatus(s){$('status').textContent=s}function base(){return $('api').value.trim().replace(/\/+$/,'')}function authHeaders(){return {'Authorization':'Bearer '+adminToken,'Content-Type':'application/json'}}
async function req(path,opts={}){if(!apiBase||!adminToken)throw Error('Nhập URL API và ADMIN_TOKEN trước.');let r;try{r=await fetch(apiBase+path,{...opts,headers:{...authHeaders(),...(opts.headers||{})}})}catch(e){throw Error('Không kết nối được API. Kiểm tra URL HTTPS, server đang chạy và ALLOWED_ORIGINS/CORS.')}let data;try{data=await r.json()}catch{data={}}if(!r.ok)throw Error(data.error==='unauthorized'?'ADMIN_TOKEN không đúng hoặc không hợp lệ.':data.error||('HTTP '+r.status));return data}
function fmt(s){if(!s)return '—';const d=new Date(s);return Number.isNaN(d.getTime())?s:d.toLocaleString('vi-VN')}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
async function load(){try{const d=await req('/api/admin/keys');const arr=d.keys||[];$('keys').innerHTML=arr.length?arr.map(k=>`<div class="listitem"><b>${esc(k.label||'Không có ghi chú')}</b><br><span class="tag">${esc(k.status||'unknown')}</span><div class="small">ID: <span class="key">${esc(k.id)}</span><br>Tạo: ${esc(fmt(k.createdAt))}<br>Hết hạn: ${esc(fmt(k.expiresAt))}<br>Lần dùng cuối: ${esc(fmt(k.lastUsedAt))}${k.revokedAt?'<br>Đã thu hồi: '+esc(fmt(k.revokedAt)):''}</div>${k.status==='active'?`<button class="danger" data-revoke="${esc(k.id)}">THU HỒI KEY NÀY</button>`:''}</div>`).join(''):'Chưa có key nào.';$('keys').querySelectorAll('[data-revoke]').forEach(b=>b.addEventListener('click',()=>revoke(b.dataset.revoke)));setStatus('Kết nối thành công. Đã tải '+arr.length+' key.')}catch(e){setStatus(e.message)}}
async function revoke(id){if(!confirm('Thu hồi key này trên toàn hệ thống? Thiết bị sẽ bị từ chối ở lần kiểm tra API tiếp theo.'))return;try{await req('/api/admin/keys/'+encodeURIComponent(id)+'/revoke',{method:'POST',body:'{}'});setStatus('Đã thu hồi key.');await load()}catch(e){setStatus(e.message)}}
$('connect').addEventListener('click',async()=>{apiBase=base();adminToken=$('token').value.trim();if(!/^https:\/\//i.test(apiBase)){setStatus('Vui lòng nhập URL API bắt đầu bằng https://');return}try{const r=await fetch(apiBase+'/health');if(!r.ok)throw Error('HTTP '+r.status);const d=await r.json();if(!d.ok)throw Error('API chưa sẵn sàng');await load()}catch(e){setStatus('Không kiểm tra được API: '+e.message+'. Kiểm tra URL, HTTPS và cấu hình CORS.')}});
$('forget').addEventListener('click',()=>{apiBase='';adminToken='';$('api').value='';$('token').value='';setStatus('Đã xóa thông tin kết nối khỏi trang hiện tại.');});
$('create').addEventListener('click',async()=>{try{if(!apiBase||!adminToken){setStatus('Hãy kết nối API trước.');return}const d=await req('/api/admin/keys',{method:'POST',body:JSON.stringify({days:Number($('days').value),label:$('label').value.trim()})});currentKey=d.key;$('newkey').classList.remove('hidden');$('copy').classList.remove('hidden');$('newkey').textContent='KEY MỚI — hãy sao chép ngay\n'+d.key+'\nGhi chú: '+(d.label||'Không có')+'\nHết hạn: '+fmt(d.expiresAt)+'\nKey gốc sẽ không thể lấy lại từ server.';setStatus('Tạo key thành công.');await load()}catch(e){setStatus(e.message)}});
$('copy').addEventListener('click',async()=>{if(!currentKey)return;try{await navigator.clipboard.writeText(currentKey);setStatus('Đã sao chép key.')}catch(e){setStatus('Không tự sao chép được trên trình duyệt này. Chạm giữ dòng key để sao chép thủ công.')}});
$('reload').addEventListener('click',()=>{apiBase=base();adminToken=$('token').value.trim();load()});
})();
</script></body></html>
